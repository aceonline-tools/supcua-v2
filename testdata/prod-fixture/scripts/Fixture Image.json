{
  "id": "fx-img-1",
  "name": "Fixture Image",
  "enabled": true,
  "group": "Utilities",
  "run_mode": "once",
  "hotkey_mode": "toggle",
  "toggle_hotkey": {
    "modifiers": [
      "ctrl",
      "alt",
      "shift"
    ],
    "key": "f8"
  },
  "actions": [
    {
      "type": "wait_for_image",
      "image": "",
      "region": {
        "x": 0,
        "y": 0,
        "width": 200,
        "height": 150
      },
      "timeout_ms": 3000,
      "use_found_position": true
    },
    {
      "type": "if_image",
      "image": "",
      "then": [
        {
          "type": "mouse_left_click"
        }
      ],
      "else": [
        {
          "type": "key_press",
          "key": "escape"
        }
      ]
    }
  ]
}